# ============================================================
# NanoURL — Spring Boot Configuration Template
# Copy this file to application.properties and fill in values
# Supports Neon DB (Free Serverless PostgreSQL) & MySQL
# ============================================================

spring.application.name=nanourl-backend

# ── Database (Neon DB / PostgreSQL) ─────────────────────────
# Paste your Neon DB connection string below:
spring.datasource.url=jdbc:postgresql://<ep-your-neon-host>.neon.tech/neondb?sslmode=require
spring.datasource.username=YOUR_NEON_USERNAME
spring.datasource.password=YOUR_NEON_PASSWORD

# ── JPA ─────────────────────────────────────────────────────
spring.jpa.hibernate.ddl-auto=update

# ── JWT ─────────────────────────────────────────────────────
# Generate a secure Base64-encoded secret (min 256-bit / 32 bytes)
jwt.secret=YOUR_BASE64_JWT_SECRET_HERE
jwt.expiration=172800000
